// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// Authentication & Users
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String    // bcrypt hashed
  isActive      Boolean   @default(true)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Relations
  memberships   UserMembership[]
  sessions      UserSession[]
  auditLogs     AuditLog[]

  @@map("users")
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Role {
  id          String  @id @default(cuid())
  name        String  // Owner, Sales, Purchasing, Operational, Finance, HR, Admin
  description String?
  isSystem    Boolean @default(false) // System-defined roles

  memberships UserMembership[]

  @@map("roles")
}

model UserMembership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  roleId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([userId, companyId, roleId])
  @@index([userId])
  @@index([companyId])
  @@map("user_memberships")
}

// ============================================================================
// Companies & Organization
// ============================================================================

model Company {
  id                String   @id @default(cuid())
  code              String   @unique // PT-A, PT-B, PT-C
  name              String
  logo              String? // URL or file path
  description       String?
  address           String?
  city              String?
  province          String?
  country           String?
  postalCode        String?
  npwp              String? // Tax ID
  phone             String?
  email             String?
  bankAccount       String? // Rekening bank
  bankName          String?
  signatoryName     String? // name printed on the invoice signature block
  signatoryTitle    String? // job title printed under the signatory name
  currency          String  @default("IDR")
  timezone          String  @default("Asia/Jakarta")
  isActive          Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  // Relations
  memberships       UserMembership[]
  customers         Customer[]
  suppliers         Supplier[]
  products          Product[]
  warehouses        Warehouse[]
  projects          Project[]
  rfqs              RFQ[]
  quotations        Quotation[]
  purchaseRequests  PurchaseRequest[]
  purchaseOrders    PurchaseOrder[]
  salesOrders       SalesOrder[]
  invoices          Invoice[]
  deliveries        Delivery[]
  bills             Bill[]
  payments          Payment[]
  goodsReceipts     GoodsReceipt[]
  supplierClaims    SupplierClaim[]
  paymentReports    PaymentReport[]
  workOrders        WorkOrder[]
  journalEntries    JournalEntry[]
  chartOfAccounts   ChartOfAccount[]
  priceInquiries    PriceInquiry[]
  employees         Employee[]

  @@map("companies")
}

// ============================================================================
// Master Data - Customers & Suppliers
// ============================================================================

model Customer {
  id            String   @id @default(cuid())
  companyId     String
  code          String   // Customer code per company
  name          String
  description   String?
  address       String?
  city          String?
  province      String?
  country       String?
  postalCode    String?
  phone         String?
  email         String?
  npwp          String? // Tax ID
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Relations
  contacts      CustomerContact[]
  rfqs          RFQ[]
  quotations    Quotation[]
  salesOrders   SalesOrder[]
  invoices      Invoice[]
  deliveries    Delivery[]
  payments      Payment[]
  projects      Project[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("customers")
}

model CustomerContact {
  id            String   @id @default(cuid())
  customerId    String
  name          String
  phone         String?
  email         String?
  position      String?
  notes         String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_contacts")
}

model Supplier {
  id            String   @id @default(cuid())
  companyId     String
  code          String   // Supplier code per company
  name          String
  description   String?
  address       String?
  city          String?
  province      String?
  country       String?
  postalCode    String?
  phone         String?
  email         String?
  npwp          String? // Tax ID
  bankAccount   String?
  bankName      String?
  picName       String? // vendor contact person, shown on the PO
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Relations
  contacts      SupplierContact[]
  purchaseOrders PurchaseOrder[]
  rfqs          SupplierRFQ[]
  bills         Bill[]
  payments      Payment[]
  inquiryVendors PriceInquiryVendor[]
  priceQuotes   PriceQuote[]
  claims        SupplierClaim[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("suppliers")
}

model SupplierContact {
  id            String   @id @default(cuid())
  supplierId    String
  name          String
  phone         String?
  email         String?
  position      String?
  notes         String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_contacts")
}

// ============================================================================
// Master Data - Products & Inventory
// ============================================================================

model ProductCategory {
  id            String   @id @default(cuid())
  name          String
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  products      Product[]

  @@map("product_categories")
}

model Unit {
  id            String   @id @default(cuid())
  code          String   @unique // M, KG, PCS, etc.
  name          String
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  products      Product[]
  stockMovements StockMovement[]
  bomItems      BOMItem[]

  @@map("units")
}

model Product {
  id            String   @id @default(cuid())
  companyId     String
  categoryId    String?
  sku           String   // Product SKU/code per company
  name          String
  description   String?
  unitId        String
  standardPrice Decimal  @db.Decimal(19, 2) @default(0)
  itemType      String   @default("goods") // goods, service — service items never carry physical stock or low-stock warnings (Tahap 6 audit)
  brand         String?
  classification String? // Genuine, Non Genuine, Registrasi Part/Jasa/Consumable/Matrial/Tools/Fabrikasi/Konveksi (Master Data MDA)
  interchange   String? // alternate/superseded part number from the dealer
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      ProductCategory? @relation(fields: [categoryId], references: [id])
  unit          Unit    @relation(fields: [unitId], references: [id])

  // Relations
  stocks        Stock[]
  bomItems      BOMItem[]
  stockMovements StockMovement[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([categoryId])
  @@map("products")
}

model Warehouse {
  id            String   @id @default(cuid())
  companyId     String
  code          String   // WH-01, WS-01 (Workshop)
  name          String
  type          String   @default("warehouse") // warehouse, workshop
  description   String?
  address       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Relations
  locations     Location[]
  stocks        Stock[]
  stockMovements StockMovement[]
  goodsReceipts GoodsReceipt[]
  deliveries    Delivery[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("warehouses")
}

model Location {
  id            String   @id @default(cuid())
  warehouseId   String
  code          String   // RAK-A1, RAK-A2, etc.
  name          String
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  // Relations
  stocks        Stock[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@map("locations")
}

model Stock {
  id            String   @id @default(cuid())
  warehouseId   String
  locationId    String?
  productId     String
  quantity      Decimal  @db.Decimal(19, 4)
  minimumStock  Decimal  @db.Decimal(19, 4) @default(0)
  lastCountedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location      Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  product       Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, locationId, productId])
  @@index([warehouseId])
  @@index([productId])
  @@map("stocks")
}

model StockMovement {
  id              String   @id @default(cuid())
  warehouseId     String
  productId       String
  unitId          String
  referenceType   String   // PO, InvoiceOut, InvoiceReturn, Adjustment, BOMUsage, etc.
  referenceId     String   // PO ID, Invoice ID, etc.
  quantity        Decimal  @db.Decimal(19, 4)
  type            String   // IN, OUT, ADJUSTMENT
  reason          String? // Penerimaan, Pengeluaran, Return, Scrap, Kembali, etc.
  notes           String?
  createdBy       String? // User ID
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit            Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@index([productId])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

// ============================================================================
// Sales Module
// ============================================================================

model RFQ {
  id            String   @id @default(cuid())
  companyId     String
  customerId    String
  number        String   // RFQ-2024-001 (auto-generated)
  title         String?
  description   String?
  requestDate   DateTime
  targetDate    DateTime? // Tanggal target jawaban
  status        String   @default("draft") // draft, sent, quoted, closed, cancelled
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Relations
  items         RFQItem[]
  quotations    Quotation[]
  supplierRFQs  SupplierRFQ[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([customerId])
  @@map("rfqs")
}

model RFQItem {
  id            String   @id @default(cuid())
  rfqId         String
  lineNumber    Int
  description   String
  quantity      Decimal  @db.Decimal(19, 4)
  unit          String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rfq           RFQ     @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@unique([rfqId, lineNumber])
  @@index([rfqId])
  @@map("rfq_items")
}

model Quotation {
  id              String   @id @default(cuid())
  companyId       String
  customerId      String
  rfqId           String?
  number          String   // QT-2024-001
  revisionNumber  Int      @default(1)
  quotationDate   DateTime
  expiryDate      DateTime
  paymentTerms    String? // DP 30%, Progress 40%, Final 30%
  validityDays    Int      @default(14)
  pic             String? // Attn / person in charge at the customer
  ppnPercent      Decimal  @default(11) @db.Decimal(5, 2)
  pphPercent      Decimal  @default(0) @db.Decimal(5, 2)
  status          String   @default("draft") // draft, sent, accepted, rejected, expired, cancelled
  notes           String?
  // Sales pipeline tracking (Tahap 4A). Kept on Quotation rather than a
  // separate CRM entity: a quotation already carries the estimated value, and
  // adding a parallel "opportunity" record would be a second place for the
  // same deal to go stale (see Tahap 1's stale-status lesson).
  salesPic        String? // internal sales rep, distinct from `pic` (the customer's contact)
  probability     Int?     @default(50) // 0-100, adjustable by the sales rep
  targetCloseDate DateTime?
  nextFollowUpAt  DateTime?
  winLossReason   String?
  estimatedMarginPercent Decimal? @db.Decimal(5, 2) // manual estimate; no cost basis exists yet at quotation stage
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rfq             RFQ?    @relation(fields: [rfqId], references: [id], onDelete: SetNull)

  // Relations
  items           QuotationItem[]
  revisions       QuotationRevision[]
  salesOrders     SalesOrder[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([customerId])
  @@map("quotations")
}

model QuotationItem {
  id            String   @id @default(cuid())
  quotationId   String
  lineNumber    Int
  partNumber    String?
  description   String
  specification String? // multi-line spec text for fabrication-mode items (Barang/Jasa + Spesifikasi); spare-part items leave this null and use partNumber + description instead
  quantity      Decimal  @db.Decimal(19, 4)
  unit          String?
  unitPrice     Decimal  @db.Decimal(19, 2)
  subtotal      Decimal  @db.Decimal(19, 2) // qty * unitPrice
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, lineNumber])
  @@index([quotationId])
  @@map("quotation_items")
}

model QuotationRevision {
  id            String   @id @default(cuid())
  quotationId   String
  revisionNumber Int
  changes       String? // JSON diff
  changedBy     String? // User ID
  changedAt     DateTime @default(now())

  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, revisionNumber])
  @@index([quotationId])
  @@map("quotation_revisions")
}

model SalesOrder {
  id            String   @id @default(cuid())
  companyId     String
  customerId    String
  quotationId   String?
  poNumber      String   // Customer PO number
  poDate        DateTime
  soNumber      String   // Sales Order number (internal)
  projectId     String? @unique
  status        String   @default("draft") // draft, confirmed, partially_delivered, delivered, invoiced, cancelled
  deliveryDebtAt DateTime? // sales acknowledged that part of the order is owed to the customer (e.g. stock short by a few pieces) while the rest is delivered and invoiced
  deliveryDebtNote String?
  procurementSkippedAt DateTime? // purchasing marked this order as fulfilled without buying (e.g. from stock)
  deliveryDate  DateTime?
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotation     Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Relations
  items         SalesOrderItem[]
  deliveries    Delivery[]
  invoices      Invoice[]
  purchaseOrders PurchaseOrder[]
  poSources     PurchaseOrderSource[]
  bills         Bill[]
  billItems     BillItem[]
  priceInquiries PriceInquiry[]

  @@unique([companyId, soNumber])
  @@index([companyId])
  @@index([customerId])
  @@index([projectId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id            String   @id @default(cuid())
  soId          String
  lineNumber    Int
  partNumber    String?
  description   String
  quantity      Decimal  @db.Decimal(19, 4)
  unit          String?
  unitPrice     Decimal  @db.Decimal(19, 2)
  subtotal      Decimal  @db.Decimal(19, 2)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  salesOrder    SalesOrder @relation(fields: [soId], references: [id], onDelete: Cascade)

  @@unique([soId, lineNumber])
  @@index([soId])
  @@map("sales_order_items")
}

// ============================================================================
// Operational Module - Projects & Work Orders
// ============================================================================

model Project {
  id                String   @id @default(cuid())
  companyId         String
  customerId        String?
  projectNumber     String   // PRJ-2024-001
  projectName       String
  description       String?
  executionMethod   String   @default("supplier") // supplier, internal_workshop, combination
  startDate         DateTime
  targetEndDate     DateTime
  actualEndDate     DateTime?
  budget            Decimal  @db.Decimal(19, 2) @default(0)
  status            String   @default("planned") // planned, in_progress, on_hold, completed, cancelled
  responsible       String? // User ID
  notes             String?
  // Estimate to complete (ETC): the one number in the profitability calc that
  // cannot be derived from existing transactions, so it is a deliberate manual
  // PIC input instead of being silently guessed (Tahap 3). Null means nobody
  // has entered an estimate yet — the profitability view must say so plainly,
  // not treat it as zero.
  estimatedCostToComplete Decimal? @db.Decimal(19, 2)
  estimatedCostNote       String?
  estimatedCostUpdatedAt  DateTime?
  estimatedCostUpdatedBy  String?
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  salesOrder        SalesOrder?

  // Relations
  workOrders        WorkOrder[]
  boms              BOM[]
  stages            ProjectStage[]
  purchaseRequests  PurchaseRequest[]
  purchaseOrders    PurchaseOrder[]
  timesheets        Timesheet[]
  reimbursements    Reimbursement[]
  changeOrders      ChangeOrder[]
  qualityChecks     QualityCheck[]
  handoverDocuments HandoverDocument[]

  @@unique([companyId, projectNumber])
  @@index([companyId])
  @@index([customerId])
  @@map("projects")
}

// Approved work-scope changes (Tahap 3 gap). Only status="approved" rows feed
// the profitability calc (lib/project-money.ts) — pending/rejected ones are
// visible for tracking but never silently move the contract value or budget.
model ChangeOrder {
  id            String   @id @default(cuid())
  projectId     String
  changeNumber  String   // CO-001
  title         String
  description   String?
  valueImpact   Decimal  @db.Decimal(19, 2) @default(0) // adjustment to contract value (can be negative)
  budgetImpact  Decimal  @db.Decimal(19, 2) @default(0) // adjustment to project budget (can be negative)
  status        String   @default("pending") // pending, approved, rejected
  requestedBy   String?
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, changeNumber])
  @@index([projectId])
  @@map("change_orders")
}

// QC checkpoints (Tahap 3 gap). Deliberately simple pass/fail/rework log tied
// to a project and optionally one of its milestones — not a full inspection
// module, just enough to answer "was this checked, by whom, did it pass".
model QualityCheck {
  id            String   @id @default(cuid())
  projectId     String
  stageId       String?
  checkNumber   String   // QC-001
  title         String
  result        String   @default("pending") // pending, passed, failed, rework
  inspectedBy   String?
  inspectedAt   DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage         ProjectStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@unique([projectId, checkNumber])
  @@index([projectId])
  @@map("quality_checks")
}

// BAST (Berita Acara Serah Terima) — the formal handover/acceptance document
// (Tahap 3 gap). Can be partial (one milestone) or final.
model HandoverDocument {
  id              String   @id @default(cuid())
  projectId       String
  documentNumber  String   // BAST-001
  handoverDate    DateTime
  scope           String?  // what is being handed over: partial/final, description
  customerSignee  String?
  companySignee   String?
  status          String   @default("draft") // draft, signed, cancelled
  notes           String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, documentNumber])
  @@index([projectId])
  @@map("handover_documents")
}

model ProjectStage {
  id            String   @id @default(cuid())
  projectId     String
  stageNumber   Int
  stageName     String   // Persiapan, Struktur, Interior, Instalasi, Pengecatan, QC
  description   String?
  progressWeight Int     @default(100) // Bobot untuk perhitungan progres
  status        String   @default("pending") // pending, in_progress, completed, on_hold
  actualStartDate DateTime?
  actualEndDate DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  qualityChecks QualityCheck[]

  @@unique([projectId, stageNumber])
  @@index([projectId])
  @@map("project_stages")
}

model WorkOrder {
  id            String   @id @default(cuid())
  companyId     String
  projectId     String
  orderNumber   String   // SPK-2024-001
  title         String?
  description   String?
  status        String   @default("draft") // draft, released, in_progress, completed, cancelled
  startDate     DateTime?
  targetEndDate DateTime?
  actualEndDate DateTime?
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)


  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([projectId])
  @@map("work_orders")
}

model BOM {
  id            String   @id @default(cuid())
  projectId     String
  bomNumber     String
  version       Int      @default(1)
  title         String
  description   String?
  status        String   @default("draft") // draft, active, superseded
  createdBy     String?
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Relations
  items         BOMItem[]

  @@unique([projectId, bomNumber, version])
  @@index([projectId])
  @@map("boms")
}

model BOMItem {
  id            String   @id @default(cuid())
  bomId         String
  productId     String
  unitId        String
  lineNumber    Int
  quantity      Decimal  @db.Decimal(19, 4)
  unitPrice     Decimal  @db.Decimal(19, 2) @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bom           BOM     @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id])
  unit          Unit    @relation(fields: [unitId], references: [id])

  @@unique([bomId, lineNumber])
  @@index([bomId])
  @@map("bom_items")
}

// ============================================================================
// Purchase Module
// ============================================================================

model PurchaseRequest {
  id            String   @id @default(cuid())
  companyId     String
  projectId     String?
  requestNumber String   // PR-2024-001 per company
  requestDate   DateTime
  requiredDate  DateTime?
  requestedBy   String? // Name of the requesting employee/department contact
  department    String? // Sales, Operational, Workshop, etc.
  status        String   @default("draft") // draft, pending_approval, approved, rejected, converted_to_po, cancelled
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Relations
  items         PurchaseRequestItem[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, requestNumber])
  @@index([companyId])
  @@index([projectId])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id             String   @id @default(cuid())
  prId           String
  productId      String?
  lineNumber     Int
  description    String
  quantity       Decimal  @db.Decimal(19, 4)
  unit           String?
  estimatedPrice Decimal  @db.Decimal(19, 2) @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchaseRequest PurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@unique([prId, lineNumber])
  @@index([prId])
  @@map("purchase_request_items")
}

model PurchaseOrder {
  id            String   @id @default(cuid())
  companyId     String
  supplierId    String
  projectId     String?
  prId          String?
  soId          String?
  poNumber      String   // PO-2024-001 per company
  poDate        DateTime
  deliveryDate  DateTime?
  paymentTerms  String?
  shipToAddress String? // defaults to the buyer company's own address when blank
  revisionNumber Int     @default(1)
  currency      String   @default("IDR")
  ppnPercent    Decimal  @default(11) @db.Decimal(5, 2)
  pphPercent    Decimal  @default(0) @db.Decimal(5, 2) // informational only — PPh withheld by MDA on a supplier invoice never reduces the PO total itself
  dpPercent     Decimal  @default(0) @db.Decimal(5, 2) // down payment (uang muka) the vendor requires before processing, % of the PO value; 0 = none
  notes         String?
  status        String   @default("draft") // draft, sent, confirmed, partial_received, received, invoiced, cancelled
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  company       Company  @relation(fields: [companyId], references: [id])
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  purchaseRequest PurchaseRequest? @relation(fields: [prId], references: [id], onDelete: SetNull)
  salesOrder    SalesOrder? @relation(fields: [soId], references: [id], onDelete: SetNull)

  // Relations
  sources       PurchaseOrderSource[]
  items         PurchaseOrderItem[]
  receipts      GoodsReceipt[]
  bills         Bill[]
  inquiryItems  PriceInquiryItem[]

  @@unique([companyId, poNumber])
  @@index([companyId])
  @@index([supplierId])
  @@index([soId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id            String   @id @default(cuid())
  poId          String
  productId     String?
  soItemId      String? // the sales-order line this PO line buys for; lets one SO be split across vendors and shows what is still unbought
  lineNumber    Int
  description   String
  brand         String?
  quantity      Decimal  @db.Decimal(19, 4)
  unit          String?
  unitPrice     Decimal  @db.Decimal(19, 2)
  subtotal      Decimal  @db.Decimal(19, 2)
  receivedQty   Decimal  @db.Decimal(19, 4) @default(0)
  invoicedQty   Decimal  @db.Decimal(19, 4) @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@unique([poId, lineNumber])
  @@index([poId])
  @@index([soItemId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id            String   @id @default(cuid())
  companyId     String
  poId          String
  warehouseId   String?
  receiptNumber String   // GR-2024-001
  receiptDate   DateTime
  status        String   @default("draft") // draft, received, inspected, accepted, rejected
  notes         String?
  inspectedByName String? // QC inspector, set when status moves to inspected/accepted/rejected
  inspectedAt   DateTime?
  // True once this receipt's quantities have been posted to stock/PO receivedQty — happens
  // once, the first time status moves off "draft". An auto-created receipt (see autoCreated)
  // starts false so it can sit waiting for SCM to confirm real quantities without
  // overstating stock before the goods have actually arrived.
  stockApplied  Boolean  @default(true)
  // True when this receipt was raised automatically because its PO was marked sent/confirmed
  // to the vendor, rather than entered by hand by SCM (Tahap 9 workflow: PO -> expected GR).
  autoCreated   Boolean  @default(false)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  // Relations
  items         GoodsReceiptItem[]
  claims        SupplierClaim[]

  @@unique([companyId, receiptNumber])
  @@index([companyId])
  @@index([poId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id            String   @id @default(cuid())
  grId          String
  poItemId      String? // Link ke PO item
  productId     String?
  quantity      Decimal  @db.Decimal(19, 4)
  unit          String?
  condition     String   @default("good") // good, defect, partial
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  goodsReceipt  GoodsReceipt @relation(fields: [grId], references: [id], onDelete: Cascade)

  @@index([grId])
  @@map("goods_receipt_items")
}

// Tracks vendor follow-up (return/claim) for goods received in defect or
// partial condition — without this, a defective item was logged but nothing
// downstream ensured the vendor actually resolved it.
model SupplierClaim {
  id            String   @id @default(cuid())
  companyId     String
  grId          String
  supplierId    String
  claimNumber   String
  status        String   @default("open") // open, resolved, rejected
  reason        String?
  resolutionNotes String?
  createdBy     String?
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?
  updatedAt     DateTime @updatedAt

  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  goodsReceipt  GoodsReceipt @relation(fields: [grId], references: [id], onDelete: Cascade)
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([companyId, claimNumber])
  @@index([companyId])
  @@index([grId])
  @@index([supplierId])
  @@map("supplier_claims")
}

// ============================================================================
// Finance Module
// ============================================================================

model Invoice {
  id            String   @id @default(cuid())
  companyId     String
  customerId    String
  soId          String?
  invoiceNumber String   // INV-2024-001
  invoiceDate   DateTime
  dueDate       DateTime?
  paymentTerms  String?
  status        String   @default("draft") // draft, sent, partial_paid, paid, overdue, cancelled
  totalAmount   Decimal  @db.Decimal(19, 2)
  ppnPercent    Decimal  @default(11) @db.Decimal(5, 2)
  taxAmount     Decimal  @db.Decimal(19, 2) @default(0)
  grandTotal    Decimal  @db.Decimal(19, 2)
  paidAmount    Decimal  @db.Decimal(19, 2) @default(0) // cash received + PPh withheld by the customer
  pphPercent    Decimal  @default(0) @db.Decimal(5, 2) // PPh 23 withheld by the customer (informational rate)
  pphAmount     Decimal  @default(0) @db.Decimal(19, 2)
  pphProofNumber String? // bukti potong received from the customer
  pphProofDate  DateTime?
  notes         String?
  collectionsPic String? // email of the staff member assigned to collect this invoice (Tahap 2 AR workbench)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  company       Company  @relation(fields: [companyId], references: [id])
  customer      Customer @relation(fields: [customerId], references: [id])
  salesOrder    SalesOrder? @relation(fields: [soId], references: [id], onDelete: SetNull)

  // Relations
  items         InvoiceItem[]
  paymentAllocations PaymentAllocation[]
  deliveries    Delivery[]
  followUps     InvoiceFollowUp[]
  paymentReports PaymentReport[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([customerId])
  @@map("invoices")
}

// Collections activity log for the AR workbench (Tahap 2): a running history of
// follow-ups, payment promises, and payment obstacles per invoice. Kept as one
// append-only table instead of denormalized "last/next follow-up" columns on
// Invoice, so there is nothing to fall out of sync (see Tahap 1: a stale
// denormalized status field is exactly what caused that bug).
model InvoiceFollowUp {
  id            String   @id @default(cuid())
  invoiceId     String
  type          String   // follow_up, payment_promise, obstacle
  note          String
  promiseDate   DateTime?
  promiseAmount Decimal? @db.Decimal(19, 2)
  nextFollowUpAt DateTime?
  createdBy     String?
  createdAt     DateTime @default(now())

  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([invoiceId, createdAt])
  @@map("invoice_follow_ups")
}

model InvoiceItem {
  id            String   @id @default(cuid())
  invoiceId     String
  lineNumber    Int
  partNumber    String?
  description   String
  quantity      Decimal  @db.Decimal(19, 4)
  unit          String?
  unitPrice     Decimal  @db.Decimal(19, 2)
  subtotal      Decimal  @db.Decimal(19, 2)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, lineNumber])
  @@index([invoiceId])
  @@map("invoice_items")
}

model Bill {
  id            String   @id @default(cuid())
  companyId     String
  supplierId    String
  poId          String?
  soId          String? // customer order this cost belongs to (when there is no PO)
  vendorInvoiceNumber String? // the vendor's own invoice number
  billNumber    String   // BILL-2024-001
  billDate      DateTime
  dueDate       DateTime?
  paymentTerms  String?
  status        String   @default("draft") // draft, received, partial_paid, paid, overdue, cancelled
  totalAmount   Decimal  @db.Decimal(19, 2)
  ppnPercent    Decimal  @default(11) @db.Decimal(5, 2)
  taxAmount     Decimal  @db.Decimal(19, 2) @default(0)
  grandTotal    Decimal  @db.Decimal(19, 2)
  paidAmount    Decimal  @db.Decimal(19, 2) @default(0) // cash paid + PPh withheld from the vendor
  pphPercent    Decimal  @default(0) @db.Decimal(5, 2) // PPh 23 we withhold from the vendor
  pphAmount     Decimal  @default(0) @db.Decimal(19, 2)
  pphProofNumber String? // bukti potong we issued
  pphProofDate  DateTime?
  pphRemittedAt DateTime? // date we paid the withheld tax to the tax office
  billKind      String   @default("regular") // regular, down_payment (DP requested by purchasing from a PO)
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  salesOrder    SalesOrder? @relation(fields: [soId], references: [id], onDelete: SetNull)

  // Relations
  items         BillItem[]
  paymentAllocations PaymentAllocation[]

  @@unique([companyId, billNumber])
  @@index([companyId])
  @@index([supplierId])
  @@map("bills")
}

model BillItem {
  id            String   @id @default(cuid())
  billId        String
  lineNumber    Int
  partNumber    String?
  poItemId      String? // the PO line this bill line invoices; drives PO invoicedQty and the SCM "belum ada tagihan" list
  soId          String? // customer order this line was bought for (overrides the bill's soId)
  description   String
  quantity      Decimal  @db.Decimal(19, 4)
  unit          String?
  unitPrice     Decimal  @db.Decimal(19, 2)
  subtotal      Decimal  @db.Decimal(19, 2)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bill          Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  salesOrder    SalesOrder? @relation(fields: [soId], references: [id], onDelete: SetNull)

  @@unique([billId, lineNumber])
  @@index([soId])
  @@index([billId])
  @@index([poItemId])
  @@map("bill_items")
}

model Payment {
  id            String   @id @default(cuid())
  companyId     String
  customerId    String? // who the kwitansi (receipt) was issued to
  supplierId    String? // vendor this payment was paid to
  referenceType String? // Invoice, Bill
  referenceId   String? // Invoice ID or Bill ID
  paymentNumber String   // KW-2024-001
  paymentDate   DateTime
  amount        Decimal  @db.Decimal(19, 2)
  method        String   // cash, transfer, check
  bankAccount   String?
  description   String? // what the payment/kwitansi is for
  notes         String?
  status        String   @default("recorded") // recorded, cleared, reversed
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  // Relations
  allocations   PaymentAllocation[]

  @@index([companyId])
  @@index([customerId])
  @@index([supplierId])
  @@index([referenceType, referenceId])
  @@map("payments")
}

model PaymentAllocation {
  id            String   @id @default(cuid())
  paymentId     String
  invoiceId     String? // Allocate to invoice
  billId        String? // Allocate to bill
  amount        Decimal  @db.Decimal(19, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payment       Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice       Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bill          Bill? @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([invoiceId])
  @@index([billId])
  @@map("payment_allocations")
}

// ============================================================================
