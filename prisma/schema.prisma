model ChartOfAccount {
  id            String   @id @default(cuid())
  companyId     String
  accountCode   String   // 1000, 1100, etc. (per company)
  accountName   String
  accountType   String   // Asset, Liability, Equity, Revenue, Expense
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, accountCode])
  @@index([companyId])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id            String   @id @default(cuid())
  companyId     String
  entryNumber   String   // JE-2024-001
  entryDate     DateTime
  description   String?
  status        String   @default("draft") // draft, posted, reversed
  reversedId    String? // If this is a reversal, link to original
  sourceType    String? // Set for system-generated entries: Invoice, Payment, Bill, Reimbursement
  sourceId      String?
  createdBy     String?
  postedBy      String?
  postedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Relations
  lines         JournalLine[]

  @@unique([companyId, entryNumber])
  @@index([companyId])
  @@index([status])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id            String   @id @default(cuid())
  journalId     String
  accountCode   String
  description   String?
  debitAmount   Decimal  @db.Decimal(19, 2) @default(0)
  creditAmount  Decimal  @db.Decimal(19, 2) @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  journalEntry  JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId])
  @@map("journal_lines")
}

// ============================================================================
// HR Module
// ============================================================================

model Employee {
  id            String   @id @default(cuid())
  companyId     String
  employeeNumber String // EMP-2024-001
  name          String
  email         String?
  phone         String?
  address       String?
  city          String?
  province      String?
  country       String?
  postalCode    String?
  dateOfBirth   DateTime?
  gender        String? // M, F, Other
  maritalStatus String? // Single, Married, Divorced
  department    String?
  position      String?
  status        String   @default("active") // active, inactive, resigned
  hireDate      DateTime
  resignDate    DateTime?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Relations
  timesheets    Timesheet[]
  leaves        Leave[]
  reimbursements Reimbursement[]

  @@unique([companyId, employeeNumber])
  @@index([companyId])
  @@map("employees")
}

model Timesheet {
  id            String   @id @default(cuid())
  employeeId    String
  projectId     String?
  workDate      DateTime
  hoursWorked   Decimal  @db.Decimal(5, 2)
  taskDescription String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([projectId])
  @@map("timesheets")
}

model Leave {
  id            String   @id @default(cuid())
  employeeId    String
  leaveType     String   // Annual, Sick, Personal, etc.
  startDate     DateTime
  endDate       DateTime
  days          Int
  reason        String?
  status        String   @default("pending") // pending, approved, rejected, cancelled
  amount        Decimal? @db.Decimal(19, 2) // document total at request time
  requestedBy   String? // User ID
  documentLabel String? // e.g. PO number, for display
  approvedBy    String? // User ID
  approvedAt    DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@map("leaves")
}

model Reimbursement {
  id            String   @id @default(cuid())
  employeeId    String
  projectId     String?
  reimbursementNumber String // REIMB-2024-001
  submissionDate DateTime
  category      String? // Transport, Meal, Accommodation, Other
  amount        Decimal  @db.Decimal(19, 2)
  notes         String?
  status        String   @default("pending") // pending, approved, rejected, paid
  approvedBy    String? // User ID
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@map("reimbursements")
}

// ============================================================================
// Cross-cutting: Attachments & Audit
// ============================================================================

model Attachment {
  id            String   @id @default(cuid())
  referenceType String   // RFQ, Quotation, SalesOrder, Project, Invoice, Bill, WorkOrder, PurchaseOrder
  referenceId   String   // Application determines correct model based on referenceType
  fileName      String
  fileSize      Int
  fileType      String? // image, pdf, doc, etc.
  filePath      String? // S3 path or local path
  mimeType      String?
  data          Bytes? // file content, stored in the database
  uploadedBy    String? // User ID
  uploadedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([referenceType, referenceId])
  @@map("attachments")
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  entityType    String   // User, Company, Product, Invoice, etc.
  entityId      String
  action        String   // CREATE, UPDATE, DELETE
  oldValue      String? // JSON
  newValue      String? // JSON
  description   String?
  ipAddress     String?
  // Set when the write had no browser session to attribute it to (an import
  // script, a batch backfill) but the row itself named who did it — e.g. its
  // own createdBy email. Kept distinct from an anonymous "Sistem" entry, which
  // has neither a userId nor an actorLabel (Tahap 8 audit).
  actorLabel    String?
  createdAt     DateTime @default(now())

  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Approval {
  id            String   @id @default(cuid())
  referenceType String   // Quotation, PurchaseOrder, etc.
  referenceId   String
  approverRole  String   // Role required to approve
  status        String   @default("pending") // pending, approved, rejected
  amount        Decimal? @db.Decimal(19, 2) // document total at request time
  requestedBy   String? // User ID
  documentLabel String? // e.g. PO number, for display
  approvedBy    String? // User ID
  approvedAt    DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt


  @@index([referenceType, referenceId])
  @@index([approverRole, status])
  @@map("approvals")
}

