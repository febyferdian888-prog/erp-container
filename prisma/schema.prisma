model DeliveryItem {
  id            String   @id @default(cuid())
  deliveryId    String
  productId     String?
  lineNumber    Int
  partNumber    String?
  description   String
  quantity      Decimal  @db.Decimal(19, 4)
  unit          String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  delivery      Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, lineNumber])
  @@index([deliveryId])
  @@map("delivery_items")
}

// ============================================================================
// Vendor price comparison (permintaan harga)
// ============================================================================

model PriceInquiry {
  id            String   @id @default(cuid())
  companyId     String
  number        String   // PH-2026-0001
  title         String
  inquiryDate   DateTime
  neededDate    DateTime?
  soId          String? // customer order these purchases are for
  status        String   @default("draft") // draft, open, awarded, closed, cancelled
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesOrder    SalesOrder? @relation(fields: [soId], references: [id], onDelete: SetNull)

  items         PriceInquiryItem[]
  vendors       PriceInquiryVendor[]

  @@unique([companyId, number])
  @@index([companyId])
  @@map("price_inquiries")
}

model PriceInquiryVendor {
  id            String   @id @default(cuid())
  inquiryId     String
  supplierId    String
  createdAt     DateTime @default(now())

  inquiry       PriceInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([inquiryId, supplierId])
  @@map("price_inquiry_vendors")
}

model PriceInquiryItem {
  id            String   @id @default(cuid())
  inquiryId     String
  lineNumber    Int
  partNumber    String?
  soItemId      String? // the sales-order line this request is for, carried onto the PO so coverage stays per line
  description   String
  quantity      Decimal  @db.Decimal(19, 4)
  unit          String?
  awardedSupplierId String? // vendor chosen for this line
  poId          String? // purchase order created from the award
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  inquiry       PriceInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  quotes        PriceQuote[]

  @@unique([inquiryId, lineNumber])
  @@index([inquiryId])
  @@index([soItemId])
  @@map("price_inquiry_items")
}

model PriceQuote {
  id            String   @id @default(cuid())
  itemId        String
  supplierId    String
  unitPrice     Decimal  @db.Decimal(19, 2) // before PPN
  leadTimeDays  Int?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  item          PriceInquiryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([itemId, supplierId])
  @@map("price_quotes")
}

// One vendor PO can consolidate items from several sales orders; PurchaseOrder.soId
// keeps the first one for older code paths, this table holds the full set.
model PurchaseOrderSource {
  id            String   @id @default(cuid())
  poId          String
  soId          String
  createdAt     DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  salesOrder    SalesOrder    @relation(fields: [soId], references: [id], onDelete: Cascade)

  @@unique([poId, soId])
  @@index([soId])
  @@map("purchase_order_sources")
}

// Sales reports "customer says they paid"; finance verifies the money landed
// and approves, which is the only thing that records the Payment.
model PaymentReport {
  id            String   @id @default(cuid())
  companyId     String
  invoiceId     String
  amount        Decimal  @db.Decimal(19, 2)
  paidDate      DateTime
  method        String   @default("transfer")
  notes         String?
  status        String   @default("pending") // pending, approved, rejected
  reportedBy    String?
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNotes   String?
  paymentId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([invoiceId])
  @@map("payment_reports")
}
