# Database Configuration
# Supabase Cloud PostgreSQL
# Transaction pooler (port 6543): used by the app at runtime. connection_limit=1
# keeps each serverless instance from opening many connections against Supabase's
# pool_size:15 cap, which was causing intermittent "max clients reached" 500s.
DATABASE_URL="postgresql://postgres.ybqtgntidxhmdfcmwast:ErpSupabase2024SecurePassXQ9@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler (port 5432): used only for `prisma db push`/migrate, which need
# a session-mode connection (prepared statements, DDL).
DIRECT_URL="postgresql://postgres.ybqtgntidxhmdfcmwast:ErpSupabase2024SecurePassXQ9@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# NextAuth.js Configuration
NEXTAUTH_URL="https://erp-app-blond.vercel.app"
# Generate secret dengan: openssl rand -base64 32
NEXTAUTH_SECRET="FStcRJZpxeAy2Qx9WIt4pMGeSDGc2CVSthqyJJI76so="

# Session Configuration
SESSION_MAX_AGE=86400

# Timezone
TZ="Asia/Jakarta"

# Admin Setup Key
ADMIN_SETUP_KEY="admin-setup-2024-secure-key"

# Aplikasi Settings
NEXT_PUBLIC_APP_NAME="ERP Container Procurement & Fabrication"
NEXT_PUBLIC_APP_VERSION="0.1.0"
